<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view for daladoc.maladie model -->
    <record id="daladoc_metrics_view_form" model="ir.ui.view">
        <field name="name">daladoc.metrics.view.form</field>
        <field name="model">daladoc.metrics</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>                        
                        <group>
                            <field name="name" />
                            <field name="description" />
                        </group>
                        <group>

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list view for daladoc.metrics model -->
    <record id="daladoc_metrics_view_tree" model="ir.ui.view">
        <field name="name">daladoc.metrics.view.tree</field>
        <field name="model">daladoc.metrics</field>
        <field name="arch" type="xml">
            <list string="Metrics">
                <field name="name" />
                <field name="description" />
            </list>
        </field>
    </record>

    <!-- Action for daladoc.metrics model -->
    <record id="daladoc_metrics_action" model="ir.actions.act_window">
        <field name="name">Metrics</field>
        <field name="res_model">daladoc.metrics</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
