<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view for daladoc.treatments model -->
    <record id="daladoc_treatments_view_form" model="ir.ui.view">
        <field name="name">daladoc.treatments.view.form</field>
        <field name="model">daladoc.treatments</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>                        
                        <group>
                            <field name="name" />
                            <field name="description" />
                        </group>
                        <group>

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list view for daladoc.treatments model -->
    <record id="daladoc_treatments_view_tree" model="ir.ui.view">
        <field name="name">daladoc.treatments.view.tree</field>
        <field name="model">daladoc.treatments</field>
        <field name="arch" type="xml">
            <list string="Treatments">
                <field name="name" />
                <field name="description" />
            </list>
        </field>
    </record>

    <!-- Action for daladoc.treatments model -->
    <record id="daladoc_treatments_action" model="ir.actions.act_window">
        <field name="name">Treatments</field>
        <field name="res_model">daladoc.treatments</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
