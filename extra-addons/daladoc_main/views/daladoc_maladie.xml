<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view for daladoc.maladie model -->
    <record id="daladoc_maladie_view_form" model="ir.ui.view">
        <field name="name">daladoc.maladie.view.form</field>
        <field name="model">daladoc.maladie</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>                        
                        <group>
                            <field name="name" />
                            <field name="description" />
                            <field name="symptoms" />
                        </group>
                        <group>
                            <field name="treatments_ids" widget="many2many_tags" />
                            <field name="metrics_ids" widget="many2many_tags" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list view for daladoc.maladie model -->
    <record id="daladoc_maladie_view_tree" model="ir.ui.view">
        <field name="name">daladoc.maladie.view.tree</field>
        <field name="model">daladoc.maladie</field>
        <field name="arch" type="xml">
            <list string="Maladies">
                <field name="name" />
            </list>
        </field>
    </record>

    <!-- Action for daladoc.maladie model -->
    <record id="daladoc_maladie_action" model="ir.actions.act_window">
        <field name="name">Maladies</field>
        <field name="res_model">daladoc.maladie</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
