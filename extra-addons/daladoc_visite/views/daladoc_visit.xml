<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Form View – Medical Visit Workflow                            -->
    <!-- ============================================================ -->
    <record id="daladoc_visit_view_form" model="ir.ui.view">
        <field name="name">daladoc.visit.view.form</field>
        <field name="model">daladoc.visit</field>
        <field name="arch" type="xml">
            <form string="Medical Visit">
                <header>
                    <!-- Statusbar widget showing the workflow progression -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="check_in,chief_complaint,examination,referrals,summary"/>

                    <!-- Workflow buttons – each visible only in its preceding state -->
                    <button name="action_start_complaint"
                            string="Proceed to Anamnesis"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'check_in'"/>

                    <button name="action_start_examination"
                            string="Proceed to Examination"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'chief_complaint'"/>

                    <button name="action_start_referrals"
                            string="Proceed to Prescriptions"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'examination'"/>

                    <button name="action_start_summary"
                            string="Proceed to Summary"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'referrals'"/>

                    <button name="action_close_visit"
                            string="Close Visit"
                            type="object"
                            class="btn-success"
                            invisible="state != 'summary' or closed_date"
                            confirm="Are you sure you want to close this visit?"/>

                    <!-- Back buttons (secondary) -->
                    <button name="action_start_checkin"
                            string="Back to Check-in"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'check_in'"/>
                </header>

                <sheet>
                    <!-- ===== Title Area ===== -->
                    <div class="oe_title">
                        <h1>
                            <field name="patient_id" placeholder="Select Patient..."
                                   options="{'no_open': True}"/>
                            <field name="name"/>
                        </h1>
                    </div>

                    <!-- Visit date – always visible -->
                    <group>
                        <group>
                            <field name="visit_date" invisible="state != 'check_in'"/>
                        </group>
                        <group>
                            <field name="closed_date" invisible="not closed_date"/>
                        </group>
                    </group>

                    <!-- ============================================================ -->
                    <!-- STATE 1: Check-in & Vitals                                    -->
                    <!-- ============================================================ -->
                    <group string="Check-in &amp; Vitals"
                           invisible="state != 'check_in'">
                        <group string="Assignment">
                            <field name="doctor_id" options="{'no_open': True}"/>
                        </group>
                        <group string="Vitals">
                            <field name="vitals_weight"/>
                            <field name="vitals_height"/>
                            <field name="vitals_bp"/>
                            <field name="vitals_temp"/>
                            <field name="vitals_heart_rate"/>
                        </group>
                    </group>

                    <!-- ============================================================ -->
                    <!-- STATE 2: Anamnesis & Chief Complaint                          -->
                    <!-- ============================================================ -->
                    <group string="Anamnesis &amp; Chief Complaint"
                           invisible="state != 'chief_complaint'">
                        <group colspan="2">
                            <field name="chief_complaint" placeholder="Primary reason for the visit..."/>
                        </group>
                        <group colspan="2">
                            <!--<field name="symptom_tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>-->
                        </group>
                        <group colspan="2">
                            <field name="history_of_present_illness"/>
                        </group>
                        <group colspan="2">
                            <field name="lifestyle_notes" placeholder="Smoking, alcohol, exercise, diet..."/>
                        </group>
                    </group>

                    <!-- ============================================================ -->
                    <!-- STATE 3: Clinical Examination & Assessment                    -->
                    <!-- ============================================================ -->
                    <group string="Clinical Examination &amp; Assessment"
                           invisible="state != 'examination'">
                        <group colspan="2">
                            <field name="physical_exam_notes"/>
                        </group>
                        <group colspan="2">
                            <field name="diagnosis_description"/>
                        </group>
                    </group>

                    <!-- ============================================================ -->
                    <!-- STATE 4: Prescriptions & Referrals                            -->
                    <!-- ============================================================ -->
                    <div class="oe_button_box" name="button_box"
                         invisible="state != 'referrals'">
                        <button name="action_view_prescriptions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-medkit"
                                invisible="state != 'referrals'">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                        </button>
                        <button name="action_view_lab_tests"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-flask"
                                invisible="state != 'referrals'">
                            <field name="lab_test_count" widget="statinfo" string="Lab Tests"/>
                        </button>
                        <button name="action_view_referrals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-share-square-o"
                                invisible="state != 'referrals'">
                            <field name="referral_count" widget="statinfo" string="Referrals"/>
                        </button>
                    </div>

                    <group string="Prescriptions &amp; Referrals"
                           invisible="state != 'referrals'">

                            <button name="action_create_prescription"
                                    string="Create Prescription"
                                    type="object"
                                    class="btn-primary"
                                    />

                            <button name="action_create_lab_test"
                                    string="Request Lab Test"
                                    type="object"
                                    class="btn-primary"
                                    />

                            <button name="action_create_referral"
                                string="Create Referral"
                                type="object"
                                class="btn-primary"
                                />
                        
                    </group>

                    <group string="Sick Leave">
                        <field name="requires_sick_leave"/>
                        <field name="sick_leave_days"
                                invisible="not requires_sick_leave"/>
                    </group>

                    <!-- ============================================================ -->
                    <!-- STATE 5: Summary, Validation & Billing                        -->
                    <!-- ============================================================ -->
                    <group string="Summary, Validation &amp; Billing"
                           invisible="state != 'summary'">
                        <group colspan="2">
                            <field name="consultation_summary"/>
                        </group>
                        <group>
                            <field name="payment_status" widget="radio"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ============================================================ -->
    <!-- List / Tree View                                              -->
    <!-- ============================================================ -->
    <record id="daladoc_visit_view_list" model="ir.ui.view">
        <field name="name">daladoc.visit.view.list</field>
        <field name="model">daladoc.visit</field>
        <field name="arch" type="xml">
            <list string="Medical Visits" decoration-info="state == 'check_in'"
                  decoration-warning="state in ('chief_complaint','examination','referrals')"
                  decoration-success="state == 'summary' and closed_date"
                  default_order="visit_date desc">
                <field name="visit_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'check_in'"
                       decoration-warning="state in ('chief_complaint','examination','referrals')"
                       decoration-success="state == 'summary'"/>
                <field name="payment_status" widget="badge"
                       decoration-danger="payment_status == 'unpaid'"
                       decoration-success="payment_status == 'paid'"
                       decoration-muted="payment_status == 'exempt'"
                       optional="show"/>
                <field name="closed_date" optional="hide"/>
            </list>
        </field>
    </record>


