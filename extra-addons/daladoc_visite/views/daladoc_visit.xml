    <!-- ============================================================ -->
    <!-- Action                                                        -->
    <!-- ============================================================ -->
    <record id="daladoc_visit_action" model="ir.actions.act_window">
        <field name="name">Medical Visits</field>
        <field name="res_model">daladoc.visit</field>
        <field name="view_mode">list,form</field>
        <!--<field name="search_view_id" ref="daladoc_visit_view_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start a new medical visit
            </p>
            <p>
                Track the entire patient visit workflow from check-in to closure.
            </p>
        </field>
    </record>

</odoo>
